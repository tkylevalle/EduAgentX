{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduagentx.example/schemas/competency/provenance-v1.json",
  "title": "EduAgentX authoritative execution provenance credential v1",
  "type": "object",
  "required": [
    "@context",
    "id",
    "type",
    "issuer",
    "validFrom",
    "credentialSubject",
    "credentialSchema",
    "environment",
    "evidenceMode",
    "evidence"
  ],
  "properties": {
    "environment": {
      "enum": [
        "simulation",
        "live"
      ]
    },
    "evidenceMode": {
      "enum": [
        "synthetic",
        "replay",
        "live"
      ]
    },
    "credentialSchema": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "const": "https://eduagentx.example/schemas/competency/provenance-v1.json"
        },
        "type": {
          "const": "JsonSchema"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "examinationId",
        "certificationDecisionId",
        "package",
        "provenance",
        "mode",
        "scores",
        "safetyResult"
      ],
      "properties": {
        "examinationId": {
          "type": "string",
          "format": "uuid"
        },
        "certificationDecisionId": {
          "type": "string",
          "format": "uuid"
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "run",
            "training",
            "examination"
          ],
          "properties": {
            "schemaVersion": {
              "const": "certification-provenance/1.0.0"
            },
            "run": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schemaVersion",
                "runId",
                "agentLearnerKey",
                "configurationFingerprint",
                "configurationVersion",
                "package",
                "executorId",
                "policyVersion",
                "environment",
                "evidenceMode",
                "source"
              ],
              "properties": {
                "schemaVersion": {
                  "const": "execution-provenance/1.0.0"
                },
                "runId": {
                  "type": "string",
                  "format": "uuid"
                },
                "agentLearnerKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "configurationFingerprint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "configurationVersion": {
                  "type": "integer",
                  "minimum": 1
                },
                "package": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "version",
                    "digest"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "digest": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                },
                "executorId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "policyVersion": {
                  "const": "reference-execution/1.0.0"
                },
                "environment": {
                  "enum": [
                    "simulation",
                    "live"
                  ]
                },
                "evidenceMode": {
                  "enum": [
                    "synthetic",
                    "replay",
                    "live"
                  ]
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "version",
                    "digest"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              }
            },
            "training": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "eventId",
                "completionDigest",
                "coverage"
              ],
              "properties": {
                "eventId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "completionDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "coverage": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schemaVersion",
                    "runId",
                    "phase",
                    "attemptId",
                    "itemCount",
                    "itemIdsDigest",
                    "receiptsDigest"
                  ],
                  "properties": {
                    "schemaVersion": {
                      "const": "execution-coverage/1.0.0"
                    },
                    "runId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "phase": {
                      "enum": [
                        "training",
                        "examination"
                      ]
                    },
                    "attemptId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "itemCount": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "itemIdsDigest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "receiptsDigest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              }
            },
            "examination": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schemaVersion",
                "runId",
                "phase",
                "attemptId",
                "itemCount",
                "itemIdsDigest",
                "receiptsDigest"
              ],
              "properties": {
                "schemaVersion": {
                  "const": "execution-coverage/1.0.0"
                },
                "runId": {
                  "type": "string",
                  "format": "uuid"
                },
                "phase": {
                  "enum": [
                    "training",
                    "examination"
                  ]
                },
                "attemptId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "itemCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "itemIdsDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "receiptsDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "mode": {
          "enum": [
            "standard",
            "fallback"
          ]
        },
        "scores": {
          "type": "object",
          "required": [
            "overallPercent",
            "tierPercents",
            "itemOutcomes"
          ],
          "properties": {
            "overallPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "tierPercents": {
              "type": "object",
              "required": [
                "recall",
                "applied",
                "adversarial"
              ],
              "properties": {
                "recall": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "applied": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "adversarial": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            "itemOutcomes": {
              "type": "array",
              "minItems": 15,
              "maxItems": 15,
              "items": {
                "type": "object",
                "required": [
                  "itemId"
                ],
                "properties": {
                  "itemId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "safetyResult": {
          "type": "object",
          "required": [
            "passed",
            "criticalViolationRuleIds",
            "failureReasons"
          ],
          "properties": {
            "passed": {
              "const": true
            },
            "criticalViolationRuleIds": {
              "type": "array",
              "maxItems": 0
            },
            "failureReasons": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      }
    },
    "credentialSubject": {
      "type": "object",
      "required": [
        "id",
        "configurationFingerprint",
        "competency"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "configurationFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "competency": {
          "type": "object",
          "required": [
            "packageId",
            "packageVersion",
            "result",
            "mode",
            "scores",
            "safetyResult"
          ],
          "properties": {
            "packageId": {
              "type": "string",
              "minLength": 1
            },
            "packageVersion": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "const": "pass"
            },
            "mode": {
              "enum": [
                "standard",
                "fallback"
              ]
            },
            "scores": {
              "type": "object",
              "required": [
                "overallPercent",
                "tierPercents",
                "itemOutcomes"
              ],
              "properties": {
                "overallPercent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "tierPercents": {
                  "type": "object",
                  "required": [
                    "recall",
                    "applied",
                    "adversarial"
                  ],
                  "properties": {
                    "recall": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "applied": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "adversarial": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  }
                },
                "itemOutcomes": {
                  "type": "array",
                  "minItems": 15,
                  "maxItems": 15,
                  "items": {
                    "type": "object",
                    "required": [
                      "itemId"
                    ],
                    "properties": {
                      "itemId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            "safetyResult": {
              "type": "object",
              "required": [
                "passed",
                "criticalViolationRuleIds",
                "failureReasons"
              ],
              "properties": {
                "passed": {
                  "const": true
                },
                "criticalViolationRuleIds": {
                  "type": "array",
                  "maxItems": 0
                },
                "failureReasons": {
                  "type": "array",
                  "maxItems": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "environment": {
          "const": "simulation"
        },
        "evidenceMode": {
          "const": "synthetic"
        }
      }
    },
    {
      "properties": {
        "environment": {
          "const": "simulation"
        },
        "evidenceMode": {
          "const": "replay"
        }
      }
    },
    {
      "properties": {
        "environment": {
          "const": "live"
        },
        "evidenceMode": {
          "const": "live"
        }
      }
    }
  ],
  "$comment": "Cross-field identity/digest/coverage checks are mandatory in the accompanying static validator. Live execution authority is not enabled by this schema."
}
