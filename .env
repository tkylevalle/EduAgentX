# ── EduAgentX — Local Development Environment ──────────────────────
# Copy this file to .env before running `make up`.
# Never commit the real .env (it is gitignored).

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_USER=eduagentx_dev
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=eduagentx
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── API Gateway ──────────────────────────────────────────────────────
GATEWAY_PORT=8080
# Sprint 1 smoke-test token only — real auth owned by api-gateway-auth
GATEWAY_TEST_TOKEN=sprint1-dev-token-changeme

# ── Console ──────────────────────────────────────────────────────────
CONSOLE_PORT=4173

# ── Agent Config ─────────────────────────────────────────────────────
EXAM_PASS_THRESHOLD=0.70
MAX_RETRY_ATTEMPTS=3

# ── General ──────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=info
