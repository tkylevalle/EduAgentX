{
  "title": "EduAgentX service health",
  "uid": "eduagentx-health",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "API Gateway",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "eduagentx-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"service-health\",instance=\"http://api-gateway:4000/health\"} and on(instance) (time() - timestamp(probe_success{job=\"service-health\"}) < 15)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNHEALTHY",
                  "color": "red"
                },
                "1": {
                  "text": "HEALTHY",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
