# Copy this file to .env before running `make up`.
# These are LOCAL/TEST-ONLY defaults for the Sprint 1 walking skeleton.
# Do not reuse these values anywhere outside a local dev checkout, and
# never commit a real .env file (it is gitignored).

POSTGRES_USER=eduagentx_dev
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=eduagentx
POSTGRES_PORT=5432

REDIS_PORT=6379

GATEWAY_PORT=8080
SYNTHETIC_AGENT_PORT=4200

# RS256 JWT auth (work package "API Gateway, authentication, and
# contracts", #3). Keys are generated locally by
# scripts/generate-dev-keys.sh (run automatically by `make up`) and are
# gitignored - never commit real key material.
JWT_ISSUER=eduagentx-api-gateway
JWT_AUDIENCE=eduagentx-platform
JWT_ACCESS_TOKEN_TTL_SECONDS=900
HEALTH_DEPENDENCY_TIMEOUT_MS=1500
JWT_PRIVATE_KEY_PATH=/app/keys/dev-jwt-private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/dev-jwt-public.pem

# Pre-shared Sprint 1 client credentials used to obtain a JWT from
# POST /v1/auth/tokens. LOCAL/TEST-ONLY - real client provisioning is
# out of scope for the walking skeleton.
AGENT_CLIENT_ID=synthetic-agent-learner-dev
AGENT_CLIENT_SECRET=changeme_local_only_agent_secret
ADMIN_CLIENT_ID=capstone-admin-dev
ADMIN_CLIENT_SECRET=changeme_local_only_admin_secret

CONSOLE_PORT=4173
