# Copy this file to .env before running `make up`.
# These are LOCAL/TEST-ONLY defaults for the Sprint 1 walking skeleton.
# Do not reuse these values anywhere outside a local dev checkout, and
# never commit a real .env file (it is gitignored).

POSTGRES_USER=eduagentx_dev
POSTGRES_PASSWORD=example-only-postgres-0123456789abcdef
REGISTRY_DB_PASSWORD=example-only-registry-0123456789abcdef
CURRICULUM_DB_PASSWORD=example-only-curriculum-0123456789abcdef
CURRICULUM_INTERNAL_KEY=example-only-not-for-production-0123456789abcdef0123456789abcdef
TRAINING_DB_PASSWORD=example-only-training-0123456789abcdef
TRAINING_INTERNAL_KEY=example-only-not-for-production-0123456789abcdef0123456789abcdef
EXAMINATION_DB_PASSWORD=example-only-examination-0123456789abcdef
EXAMINATION_INTERNAL_KEY=example-only-not-for-production-0123456789abcdef0123456789abcdef
CERTIFICATION_DB_PASSWORD=example-only-certification-0123456789abcdef
CERTIFICATION_INTERNAL_KEY=example-only-not-for-production-0123456789abcdef0123456789abcdef
CERTIFICATION_KEY_ID=https://eduagentx.example/issuers/eduagentx#dev-ed25519-1
CERTIFICATION_PRIVATE_KEY_PATH=/app/keys/certification-ed25519-private.pem
CERTIFICATION_ISSUER=https://eduagentx.example/issuers/eduagentx
CREDENTIAL_BASE_URL=https://eduagentx.example/credentials
CERTIFICATION_SWEEP_INTERVAL_MS=1000
# Restricted grader/finalizer capability; never forwarded by the Gateway.
EXAMINATION_GRADING_KEY=example-only-grading-0123456789abcdef0123456789abcdef
# Shared key for the Examination Engine's calls to grading-service /v1/item-grades.
GRADING_SERVICE_KEY=example-only-not-for-production-0123456789abcdef0123456789abcdef
# Local technical default; release policy should approve the exam duration.
EXAM_DURATION_MINUTES=60
POSTGRES_DB=eduagentx
POSTGRES_PORT=5432

REDIS_PORT=6379

GATEWAY_PORT=8080
SYNTHETIC_AGENT_PORT=4200

# RS256 JWT auth (work package "API Gateway, authentication, and
# contracts", #3). Keys are generated locally by
# scripts/generate-test-keys.js (run automatically by `make up`) and are
# gitignored - never commit real key material.
JWT_ISSUER=eduagentx-api-gateway
JWT_AUDIENCE=eduagentx-platform
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_PRIVATE_KEY_PATH=/app/keys/dev-jwt-private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/dev-jwt-public.pem

# Pre-shared Sprint 1 client credentials used to obtain a JWT from
# POST /v1/auth/tokens. LOCAL/TEST-ONLY - real client provisioning is
# out of scope for the walking skeleton.
AGENT_CLIENT_ID=synthetic-agent-learner-dev
AGENT_CLIENT_SECRET=example-only-agent-client-0123456789abcdef
ADMIN_CLIENT_ID=capstone-admin-dev
ADMIN_CLIENT_SECRET=example-only-admin-client-0123456789abcdef

# Optional Issue #27 identities ("Governance, Demonstration Lab, and
# permissions"), same shape as the required ones above. Leave any of these
# unset to disable that role; admin can still reach governance routes.
# GOVERNANCE_OPERATOR_1/2 are two DISTINCT identities, same pattern as
# REVIEWER_1/2 above — governance commands such as quarantine release
# require two distinct approving subjects before they execute.
VIEWER_CLIENT_ID=capstone-viewer-dev
VIEWER_CLIENT_SECRET=example-only-viewer-client-0123456789abcdef
EVALUATOR_CLIENT_ID=capstone-evaluator-dev
EVALUATOR_CLIENT_SECRET=example-only-evaluator-client-0123456789abcdef
GOVERNANCE_OPERATOR_1_CLIENT_ID=capstone-governance-a-dev
GOVERNANCE_OPERATOR_1_CLIENT_SECRET=example-only-governance-a-client-0123456789abcdef
GOVERNANCE_OPERATOR_2_CLIENT_ID=capstone-governance-b-dev
GOVERNANCE_OPERATOR_2_CLIENT_SECRET=example-only-governance-b-client-0123456789abcdef
DEMO_OPERATOR_CLIENT_ID=capstone-demo-operator-dev
DEMO_OPERATOR_CLIENT_SECRET=example-only-demo-operator-client-0123456789abcdef

GRAFANA_ADMIN_PASSWORD=example-only-grafana-0123456789abcdef

CONSOLE_PORT=4173
