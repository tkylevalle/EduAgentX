# Copy this file to .env before running `make up`.
# These are LOCAL/TEST-ONLY defaults for the Sprint 1 walking skeleton.
# Do not reuse these values anywhere outside a local dev checkout, and
# never commit a real .env file (it is gitignored).

POSTGRES_USER=eduagentx_dev
POSTGRES_PASSWORD=
REGISTRY_DB_PASSWORD=
CURRICULUM_DB_PASSWORD=
CURRICULUM_INTERNAL_KEY=
TRAINING_DB_PASSWORD=
TRAINING_INTERNAL_KEY=
EXAMINATION_DB_PASSWORD=
EXAMINATION_INTERNAL_KEY=
CERTIFICATION_DB_PASSWORD=
CERTIFICATION_INTERNAL_KEY=
CERTIFICATION_KEY_ID=https://eduagentx.example/issuers/eduagentx#dev-ed25519-1
CERTIFICATION_PRIVATE_KEY_PATH=/app/keys/certification-ed25519-private.pem
CERTIFICATION_ISSUER=https://eduagentx.example/issuers/eduagentx
CREDENTIAL_BASE_URL=https://eduagentx.example/credentials
CERTIFICATION_SWEEP_INTERVAL_MS=1000
# Restricted grader/finalizer capability; never forwarded by the Gateway.
EXAMINATION_GRADING_KEY=
# Shared key for the Examination Engine's calls to grading-service /v1/item-grades.
GRADING_SERVICE_KEY=
# Local technical default; release policy should approve the exam duration.
EXAM_DURATION_MINUTES=60
POSTGRES_DB=eduagentx
POSTGRES_PORT=5432

REDIS_PORT=6379

GATEWAY_PORT=8080
SYNTHETIC_AGENT_PORT=4200

# RS256 JWT auth (work package "API Gateway, authentication, and
# contracts", #3). Keys are generated locally by
# scripts/generate-test-keys.js (run automatically by `make up`) and are
# gitignored - never commit real key material.
JWT_ISSUER=eduagentx-api-gateway
JWT_AUDIENCE=eduagentx-platform
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_PRIVATE_KEY_PATH=/app/keys/dev-jwt-private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/dev-jwt-public.pem

# Pre-shared Sprint 1 client credentials used to obtain a JWT from
# POST /v1/auth/tokens. LOCAL/TEST-ONLY - real client provisioning is
# out of scope for the walking skeleton.
AGENT_CLIENT_ID=synthetic-agent-learner-dev
AGENT_CLIENT_SECRET=
ADMIN_CLIENT_ID=capstone-admin-dev
ADMIN_CLIENT_SECRET=
GRAFANA_ADMIN_PASSWORD=

CONSOLE_PORT=4173
